[run]
omit =
    */tests/*
    *apps.py
    *manage.py
    *__init__.py
    *migrations*
    *asgi*
    *wsgi*
    *admin.py
    *urls.py
    */settings/*
    */core/CustomErrorManager/exception_handler.py

[report]
omit =
    */tests/*
    *apps.py
    *manage.py
    *__init__.py
    */migrations/*
    *asgi*
    *wsgi*
    *admin.py
    *urls.py
    */settings*
    */core/CustomErrorManager/exception_handler.py